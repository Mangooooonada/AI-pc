# ---------------------------------------------------------------------------
# Copy this file to ".env" and edit. Everything here is optional.
# ---------------------------------------------------------------------------

# Which brain to use: auto | openai | ollama | offline
# "auto" = OpenAI if a key is set, else Ollama if running, else offline keywords.
JARVIS_PROVIDER=auto

# --- Option A: OpenAI (paid, smartest) -------------------------------------
# Get a key at https://platform.openai.com/api-keys  (see README for steps)
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Works with any OpenAI-compatible service (Groq, Together, OpenRouter, LM Studio):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# --- Option B: Ollama (free, local, private) -------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Context window size. Ollama's own default (2k-4k) silently chops the system
# prompt + tools — 12288 comfortably fits ~40 remembered turns on a 7-8B model.
OLLAMA_NUM_CTX=12288
# How long the model stays loaded after you stop chatting (faster replies).
OLLAMA_KEEP_ALIVE=30m
# For thinking-style models (qwen3 etc.): force plain answers with 'false',
# or leave unset to use the model default.
# OLLAMA_THINK=false

# --- Personality -----------------------------------------------------------
JARVIS_NAME=Jarvis
JARVIS_USER_TITLE=Sir
JARVIS_WAKE_WORD=jarvis

# --- Interface -------------------------------------------------------------
JARVIS_PORT=8600
JARVIS_VOICE=true
JARVIS_TTS_RATE=185
JARVIS_TTS_VOICE=david

# --- Safety ----------------------------------------------------------------
JARVIS_ALLOW_POWER=true    # allow shutdown / restart / sign out
JARVIS_ALLOW_SHELL=false   # allow arbitrary shell commands (leave false)
# JARVIS_WORKSPACE=C:\Users\you\JarvisFiles
# Folder the "ask my documents" skill searches (default: <workspace>/docs)
# JARVIS_DOCS_DIR=
# Google Calendar/Gmail: path to OAuth Desktop client JSON (also found
# automatically as credentials.json in the Jarvis folder or workspace)
# JARVIS_GOOGLE_CREDENTIALS=
